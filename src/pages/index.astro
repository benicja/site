---
import Layout from '../layouts/Layout.astro';
import { SESSION_COOKIE, getApprovedUser, getUserFromSession } from '../lib/auth';

const sessionId = Astro.cookies.get(SESSION_COOKIE)?.value;
const user = sessionId ? await getUserFromSession(sessionId) : null;
const approvedUser = user ? await getApprovedUser(user.user_email) : null;
const isAdmin = approvedUser?.role === 'admin';
---

<Layout
  title="Benicja's Kitchen"
  description="Family recipes and photo gallery - a place to share our favorite moments and meals"
  user={user}
  isAdmin={isAdmin}
>
  <!-- Hero Section -->
  <section class="relative h-[calc(100vh-80px)] flex items-center justify-center bg-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute inset-0 bg-gradient-to-b from-white/10 via-white/40 to-white/90 z-10"></div>
      <img
        src="/images/hero-kitchen.jpg"
        class="w-full h-full object-cover opacity-20 scale-105"
        style="object-position: center 25%"
        alt="Kitchen backdrop"
      />
    </div>

    <div class="relative z-20 max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-5xl md:text-7xl font-serif font-black text-gray-900 mb-6 tracking-tight">
        Benicja's Kitchen
      </h1>
      <p class="text-xl md:text-2xl text-gray-600 font-light max-w-2xl mx-auto mb-10 leading-relaxed">
        A collection of our recipes and photos to share with family and friends. We hope you enjoy!
        <span class="block mt-4 font-serif italic opacity-70">~ Alicja & Ben</span>
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href="/recipes" 
          class="px-8 py-4 bg-gray-900 text-white rounded-full font-medium text-lg hover:bg-gray-800 transition-all transform hover:scale-105 shadow-xl"
        >
          Browse Recipes
        </a>
        <a
          href="/gallery"
          class="px-8 py-4 bg-white border-2 border-gray-200 text-gray-900 rounded-full font-medium text-lg hover:border-gray-900 transition-all transform hover:scale-105"
        >
          View Gallery
        </a>
        {isAdmin && (
          <a
            href="/portal"
            class="px-8 py-4 bg-white border-2 border-gray-200 text-gray-900 rounded-full font-medium text-lg hover:border-gray-900 transition-all transform hover:scale-105"
          >
            View Admin
          </a>
        )}
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  html, body {
    overflow: hidden !important;
    height: 100%;
  }
</style>