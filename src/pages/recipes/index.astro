---
// Prerendered at build so the page is a pure CDN hit and hover-prefetch makes
// navigation instant. The custom order and soft-deletes are baked in at build
// time so the first paint is correct; client-side page-data then reconciles
// anything that changed since the last deploy (plus hearts and auth state)
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import { supabaseAdmin } from '../../lib/supabase';

const allRecipes = await getCollection('recipes');

// Best-effort at build time; the page still builds if Supabase is unreachable
let recipeOrder: string[] = [];
let deletedSlugs = new Set<string>();
try {
  const [orderRes, deletedRes] = await Promise.all([
    supabaseAdmin.from('recipe_order').select('order_slugs').eq('id', 'primary').maybeSingle(),
    supabaseAdmin.from('deleted_recipes').select('recipe_slug')
  ]);
  recipeOrder = orderRes.data?.order_slugs || [];
  deletedSlugs = new Set((deletedRes.data || []).map((d) => d.recipe_slug));
} catch (error) {
  console.warn('Could not load recipe order/deletions at build time', error);
}

const recipes = allRecipes.filter((recipe) => !deletedSlugs.has(recipe.slug));

// Custom order first, then publishDate (newest first), then alphabetical
const sortedRecipes = recipes.sort((a, b) => {
  const aIndex = recipeOrder.indexOf(a.slug);
  const bIndex = recipeOrder.indexOf(b.slug);
  if (aIndex !== -1 && bIndex !== -1) return aIndex - bIndex;
  if (aIndex !== -1) return -1;
  if (bIndex !== -1) return 1;
  const dateDiff = (b.data.publishDate?.getTime() || 0) - (a.data.publishDate?.getTime() || 0);
  if (dateDiff !== 0) return dateDiff;
  return a.data.title.localeCompare(b.data.title);
});

const formatCategories = (value: unknown): string => (Array.isArray(value) ? value.join(',') : String(value));
---

<style>
  @keyframes page-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .recipes-page {
    animation: page-fade-in 0.25s ease-out;
  }
</style>

<Layout title="Recipes" description="A collection of our favorite family recipes." resolveAuth={false}>
  <div class="recipes-page max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-4 sm:pb-10">
    {recipes.length > 0 ? (
      <div class="space-y-6">
        {/* Search & Filters */}
        <div class="space-y-4">
          <div class="w-full">
            <div class="relative">
              <input 
                type="text" 
                id="recipe-search" 
                placeholder="Search recipes..." 
                class="w-full px-5 py-3 bg-white border border-gray-300 rounded-xl focus:outline-none focus:border-gray-600 font-normal text-black text-base"
                inputmode="search"
                autocomplete="off"
                enterkeyhint="search"
                autocapitalize="off"
                spellcheck="false"
                tabindex="0"
              />
              <div class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2" data-filter-group>
            {[ 'Breakfast', 'Dinner', 'Dessert' ].map(cat => (
              <button 
                type="button"
                class="filter-btn px-4 py-1.5 rounded-full border border-gray-200 bg-white text-[10px] font-bold uppercase tracking-widest text-gray-600 select-none data-[active=true]:bg-[#c2410c]/5 data-[active=true]:text-[#c2410c] data-[active=true]:border-[#c2410c] md:[&:not([data-active=true])]:hover:text-gray-900 md:[&:not([data-active=true])]:hover:border-gray-400"
                data-filter="category"
                data-value={cat.toLowerCase()}
                data-active="false"
              >
                {cat}
              </button>
            ))}
            
            {/* Hidden until page-data confirms a signed-in user */}
            {(
              <button
                type="button"
                class="filter-btn hidden px-4 py-1.5 rounded-full border border-gray-200 bg-white text-[10px] font-bold uppercase tracking-widest text-gray-600 select-none items-center gap-2 data-[active=true]:bg-[#c2410c]/5 data-[active=true]:text-[#c2410c] data-[active=true]:border-[#c2410c] md:[&:not([data-active=true])]:hover:text-gray-900 md:[&:not([data-active=true])]:hover:border-gray-400"
                data-filter="hearted"
                data-requires-auth
                data-active="false"
              >
                <svg class="w-3.5 h-3.5 fill-none stroke-current" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                </svg>
                Favourites
              </button>
            )}
          </div>
        </div>

        <section>
          <!-- Cards deliberately carry no content-visibility: its estimated
               placeholder height differs from a real card, so total page height
               changed as you scrolled and scroll restoration landed short -->
          <div id="recipes-grid" class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-x-8 md:gap-y-8">
            {sortedRecipes.map((recipe, index) => (
              <div
                class={`recipe-item${index < 12 ? ' rise' : ''}`}
                style={index < 12 ? `--rise-delay: ${index * 40}ms` : ''}
                data-title={recipe.data.title.toLowerCase()}
                data-category={formatCategories(recipe.data.category).toLowerCase()}
                data-hearted="false"
              >
                <RecipeCard recipe={recipe} />
              </div>
            ))}
          </div>
          <div id="no-results" class="hidden py-32 text-center">
             <h2 class="text-2xl font-serif text-gray-400">No recipes match your search.</h2>
          </div>
        </section>

        <script is:inline>
          // Applies cached page state (custom order, deletions, heart counts,
          // the user's hearted recipes, signed-in flag) to the static grid.
          // Runs synchronously right after the grid is parsed, before first
          // paint, so nothing visibly pops or reshuffles when coming back to
          // this page. The module script re-uses it via
          // window.__applyRecipesLayout once fresh page-data arrives
          (function () {
            function slugOf(item) {
              var card = item.querySelector('[data-recipe-slug]');
              return card ? card.getAttribute('data-recipe-slug') : null;
            }

            function applyRecipesLayout(layout, settle) {
              var grid = document.getElementById('recipes-grid');
              if (!grid || !layout) return;

              if (layout.deleted && layout.deleted.length) {
                var deleted = {};
                layout.deleted.forEach(function (slug) { deleted[slug] = true; });
                Array.prototype.slice.call(grid.children).forEach(function (item) {
                  var slug = slugOf(item);
                  if (slug && deleted[slug]) item.remove();
                });
              }

              if (layout.order && layout.order.length) {
                var current = Array.prototype.slice.call(grid.children);
                var bySlug = {};
                current.forEach(function (item) {
                  var slug = slugOf(item);
                  if (slug) bySlug[slug] = item;
                });

                var ordered = [];
                layout.order.forEach(function (slug) {
                  if (bySlug[slug]) {
                    ordered.push(bySlug[slug]);
                    delete bySlug[slug];
                  }
                });
                current.forEach(function (item) {
                  var slug = slugOf(item);
                  if (!slug || bySlug[slug]) ordered.push(item);
                });

                var changed = ordered.some(function (el, i) { return el !== current[i]; });
                if (changed) {
                  // Moving a node restarts its CSS animation, so if this runs
                  // after paint (settle), finish the entrance first
                  if (settle) {
                    current.forEach(function (el) { el.classList.remove('rise'); });
                  }
                  ordered.forEach(function (el, i) {
                    // Only the first screenful staggers in; everything deeper
                    // must be instantly visible for scroll restoration
                    if (i < 12 && el.classList.contains('rise')) {
                      el.style.setProperty('--rise-delay', i * 40 + 'ms');
                    } else {
                      el.classList.remove('rise');
                    }
                    grid.appendChild(el);
                  });
                }
              }

              var userHearts = {};
              (layout.userHearts || []).forEach(function (slug) { userHearts[slug] = true; });
              var hasCounts = !!layout.hearts;

              Array.prototype.slice.call(grid.children).forEach(function (item) {
                var btn = item.querySelector('.heart-button');
                var slug = btn && btn.getAttribute('data-slug');
                if (!btn || !slug) return;

                btn.setAttribute('data-user', layout.authenticated ? 'true' : 'false');

                if (hasCounts) {
                  var countEl = item.querySelector('.heart-count');
                  if (countEl) countEl.textContent = String(layout.hearts[slug] || 0);
                }

                // Both directions, so signing out or un-hearting elsewhere
                // corrects the card instead of leaving it stuck red
                var hearted = !!userHearts[slug];
                btn.setAttribute('data-hearted', hearted ? 'true' : 'false');
                item.setAttribute('data-hearted', hearted ? 'true' : 'false');
                var topSvg = btn.querySelector('.top-heart-icon');
                if (topSvg) {
                  if (hearted) {
                    topSvg.classList.remove('fill-none', 'stroke-white', 'text-white');
                    topSvg.classList.add('fill-red-500', 'stroke-red-500', 'text-red-500');
                    topSvg.setAttribute('fill', 'currentColor');
                  } else {
                    topSvg.classList.add('fill-none', 'stroke-white', 'text-white');
                    topSvg.classList.remove('fill-red-500', 'stroke-red-500', 'text-red-500');
                    topSvg.setAttribute('fill', 'none');
                  }
                }
              });

              document.querySelectorAll('[data-requires-auth]').forEach(function (el) {
                if (layout.authenticated) {
                  el.classList.remove('hidden');
                  el.classList.add('flex');
                } else {
                  el.classList.add('hidden');
                  el.classList.remove('flex');
                }
              });
            }

            window.__applyRecipesLayout = applyRecipesLayout;
            try {
              applyRecipesLayout(JSON.parse(localStorage.getItem('recipes_layout_v2') || 'null'));
            } catch (e) {}
          })();
        </script>
      </div>
    ) : (
      <div class="py-32 text-center border-t border-gray-100">
         <h2 class="text-2xl font-serif text-gray-400">Our recipe book is currently empty.</h2>
         <p class="text-sm text-gray-400 mt-4 uppercase tracking-widest font-bold">Check back soon for upcoming treats.</p>
      </div>
    )}
  </div>



  <script>
    import { getPageData } from '../../lib/pageData';

    // The page is prerendered, so hearts, custom ordering, soft-deletes and
    // signed-in state arrive via one page-data fetch. Everything visual is
    // also cached in localStorage and applied pre-paint by the inline script
    // below the grid, so this fresh pass is usually a no-op visually
    async function applyPageData() {
      const data = await getPageData();
      if (!data) return;

      const layout = {
        order: data.order,
        deleted: data.deleted,
        authenticated: data.authenticated,
        hearts: data.hearts,
        userHearts: data.userHearts,
      };
      try {
        localStorage.setItem('recipes_layout_v2', JSON.stringify(layout));
      } catch {}
      (window as any).__applyRecipesLayout?.(layout, true);
    }

    function initSearch() {
      const searchInput = document.getElementById('recipe-search') as HTMLInputElement | null;
      const recipeItems = document.querySelectorAll('.recipe-item') as NodeListOf<HTMLElement>;
      const recipesGrid = document.getElementById('recipes-grid');
      const noResults = document.getElementById('no-results');
      const filterBtns = document.querySelectorAll('.filter-btn');
      const filterGroup = document.querySelector('[data-filter-group]');

      if (!searchInput) return;

      // Items are already visible, no animation needed
      const revealItems = () => {
        // No-op: animations removed
      };
      
      revealItems();


      let activeCategory: string | null = null;
      let showHeartedOnly = false;

      const normalize = (str: string) => str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

      function updateGrid() {
        if (!searchInput || !noResults || !recipesGrid) return;

        const query = normalize(searchInput.value.trim());
        let hasResults = false;


        recipeItems.forEach(item => {
          const title = normalize(item.getAttribute('data-title') || '');
          const category = item.getAttribute('data-category');
          const isHearted = item.getAttribute('data-hearted') === 'true';

          let matchesSearch = title.includes(query);
          let matchesCategory = true;
          if (activeCategory) {
            const categories = (category || '')
              .split(',')
              .map(cat => cat.trim().toLowerCase())
              .filter(Boolean);
            matchesCategory = categories.includes(activeCategory);
          }
          let matchesHearted = !showHeartedOnly || isHearted;

          const shouldShow = matchesSearch && matchesCategory && matchesHearted;
          item.hidden = !shouldShow;
          if (shouldShow) {
            hasResults = true;
          }
        });

        if (hasResults) {
          noResults.classList.add('hidden');
          recipesGrid.classList.remove('hidden');
        } else {
          noResults.classList.remove('hidden');
          recipesGrid.classList.add('hidden');
        }
      }

      function handleFilterClick(btn: HTMLElement) {
        const type = btn.getAttribute('data-filter');
        const value = btn.getAttribute('data-value');
        const wasActive = btn.getAttribute('data-active') === 'true';

        // If already active, just toggle off
        if (wasActive) {
          btn.setAttribute('data-active', 'false');
          if (type === 'category') {
            activeCategory = null;
          } else if (type === 'hearted') {
            showHeartedOnly = false;
            const heartSvg = btn.querySelector('svg');
            heartSvg?.classList.remove('fill-current');
          }
          // Defer filtering to next frame for smooth button response
          requestAnimationFrame(updateGrid);
          return;
        }

        // Deselect all filter buttons
        filterBtns.forEach(b => {
          b.setAttribute('data-active', 'false');
          if (b.getAttribute('data-filter') === 'hearted') {
            const heartSvg = b.querySelector('svg');
            heartSvg?.classList.remove('fill-current');
          }
        });
        activeCategory = null;
        showHeartedOnly = false;

        // Activate the clicked button
        btn.setAttribute('data-active', 'true');
        if (type === 'category') {
          activeCategory = value ? value.toLowerCase() : null;
        } else if (type === 'hearted') {
          showHeartedOnly = true;
          const heartSvg = btn.querySelector('svg');
          heartSvg?.classList.add('fill-current');
        }
        // Defer filtering to next frame for smooth button response
        requestAnimationFrame(updateGrid);
      }

      // Bind directly to buttons
      filterBtns.forEach(btn => {
        if (btn.getAttribute('data-inited') === 'true') return;
        btn.setAttribute('data-inited', 'true');
        btn.addEventListener('click', (event) => {
          event.preventDefault();
          handleFilterClick(btn as HTMLElement);
        });
      });


      // Prevent auto-focus on mobile (do not focus on load)
      // Only add event listener for input
      searchInput.addEventListener('input', updateGrid);

      // Check URL for initial category
      const urlParams = new URLSearchParams(window.location.search);
      const initialCat = urlParams.get('category')?.toLowerCase();
      if (initialCat) {
        const targetBtn = Array.from(filterBtns).find(b => b.getAttribute('data-value') === initialCat);
        if (targetBtn) (targetBtn as HTMLElement).click();
      }

      function hydrateCardElement(item: HTMLElement, slug: string, data: any) {
        const card = item.querySelector('[data-recipe-slug]');
        if (card) card.setAttribute('data-recipe-slug', slug);
        
        // Update item data attributes for search/filter
        item.setAttribute('data-title', data.title.toLowerCase());
        item.setAttribute('data-category', data.category.toLowerCase());

        // Update card title
        const titleLink = item.querySelector('.recipe-link');
        if (titleLink) {
          titleLink.textContent = data.title;
          titleLink.setAttribute('href', `/recipes/${slug}`);
        }
        
        // Update image link
        const imageLink = item.querySelector('a.block.group');
        if (imageLink) {
          imageLink.setAttribute('href', `/recipes/${slug}`);
        }

        // Update heart button
        const heartBtn = item.querySelector('.heart-button');
        if (heartBtn) {
          heartBtn.setAttribute('data-slug', slug);
          heartBtn.setAttribute('data-hearted', 'false');
          const heartCount = item.querySelector('.heart-count');
          if (heartCount) heartCount.textContent = '0';
        }

        // Update description
        const desc = item.querySelector('p.text-gray-500');
        if (desc) desc.textContent = data.description;

        // Update category tags
        const tags = item.querySelectorAll('.category-tag');
        tags.forEach((tag: Element) => {
          const t = tag as HTMLElement;
          t.textContent = data.category;
          t.setAttribute('data-category', data.category);
          t.setAttribute('href', `/recipes?category=${data.category.toLowerCase()}`);
        });

        // Update image
        const img = (item.querySelector('.hydrate-image') || item.querySelector('img')) as HTMLImageElement | null;
        const fallback = item.querySelector('.hero-fallback');
        if (img && data.featured_image) {
          img.src = data.featured_image;
          img.alt = data.title;
          
          // Try loading from IndexedDB if it was recently added
          const win = window as any;
          if ( win.recipeImageCache ) {
            win.recipeImageCache.get(data.featured_image).then((cachedUrl: string | null) => {
              if (cachedUrl) img.src = cachedUrl;
            });
          }

          img.classList.remove('hidden');
          if (fallback) fallback.classList.add('hidden');
        }

        // Update total time
        const totalTime = (data.prep_time || 0) + (data.cook_time || 0);
        const timeSpan = item.querySelector('.text-xs.md\\:text-sm.font-light.lowercase.text-gray-600');
        if (timeSpan) timeSpan.textContent = `${totalTime} min`;

        // Show item
        item.classList.remove('opacity-0', 'invisible');
        item.style.opacity = '1';
        item.style.visibility = 'visible';
      }

      function hydrateCards() {
        const grid = document.getElementById('recipes-grid');
        const currentItems = document.querySelectorAll('.recipe-item');
        const existingSlugs = new Set();

        // Hydrate existing cards
        currentItems.forEach(item => {
          const card = item.querySelector('[data-recipe-slug]');
          if (!card) return;
          const slug = card.getAttribute('data-recipe-slug');
          if (!slug) return;
          existingSlugs.add(slug);

          const cacheKey = 'recipe_pending_v1_' + slug;
          const raw = localStorage.getItem(cacheKey);
          if (!raw) return;

          try {
            const { timestamp, data } = JSON.parse(raw);
            if (Date.now() - timestamp > 10 * 60 * 1000) {
              localStorage.removeItem(cacheKey);
              return;
            }

            hydrateCardElement(item as HTMLElement, slug, data);
          } catch (e) {}
        });

        // Inject new cards from cache
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (key && key.startsWith('recipe_pending_v1_')) {
            const slug = key.replace('recipe_pending_v1_', '');
            if (!existingSlugs.has(slug)) {
              try {
                const itemRaw = localStorage.getItem(key);
                if (!itemRaw) continue;
                
                const { timestamp, data } = JSON.parse(itemRaw);
                if (Date.now() - timestamp < 10 * 60 * 1000) {
                  const template = currentItems[0];
                  if (template && grid) {
                    const newItem = template.cloneNode(true) as HTMLElement;
                    grid.prepend(newItem);
                    hydrateCardElement(newItem, slug, data);
                    // The static build doesn't have this recipe yet, so link
                    // to the SSR ghost route instead of a guaranteed 404
                    const pendingHref = `/recipes/pending/${slug}`;
                    newItem.querySelector('.recipe-link')?.setAttribute('href', pendingHref);
                    newItem.querySelector('a.block.group')?.setAttribute('href', pendingHref);
                  }
                }
              } catch (e) {}
            }
          }
        }

        // Re-run grid update to apply current filters to new cards
        updateGrid();
      }

      hydrateCards();
    }

    let navDirection = 'forward';
    document.addEventListener('astro:before-preparation', (event) => {
      navDirection = (event as any).direction;
    });

    // After a client-side swap the fresh DOM is back in build order; re-apply
    // the cached layout synchronously, before the browser paints the new page
    document.addEventListener('astro:after-swap', () => {
      if (!document.getElementById('recipes-grid')) return;

      // Going back restores a scroll position, so the entrance animation must
      // not run: cards start invisible and would pop in around wherever the
      // restore landed
      if (navDirection === 'back') {
        document.querySelectorAll('.recipe-item.rise').forEach((el) => el.classList.remove('rise'));
      }

      try {
        (window as any).__applyRecipesLayout?.(
          JSON.parse(localStorage.getItem('recipes_layout_v2') || 'null')
        );
      } catch {}
    });

    // Re-initialize after view transitions
    document.addEventListener('astro:page-load', () => {
      initSearch();
      applyPageData();
    });
  </script>
</Layout>