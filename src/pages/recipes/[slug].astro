---
// Prerendered at build so navigation from /recipes is a pure CDN hit.
// Session-dependent data (heart count, comment auth) hydrates client-side
// via /api/recipes/page-data. This file also doubles as the ghost page:
// /recipes/pending/[slug].astro renders it server-side for slugs that
// don't exist yet (recipes created in the portal before the rebuild lands).
export const prerender = true;
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AddAllToShoppingListButton from '../../components/AddAllToShoppingListButton.astro';
import CommentSection from '../../components/CommentSection';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => ({ params: { slug: recipe.slug } }));
}

const { slug } = Astro.params;
let recipe = await getEntry('recipes', slug as string);
const isGhost = !recipe;

// Rendered as 0 at build; the client fetches the live count and eases up to it
const heartCount = 0;

const data = isGhost ? {
  title: 'Preparing your recipe...',
  description: 'This recipe was just created and is being processed. It should appear in a few moments!',
  category: 'New Recipe',
  prep_time: 0,
  cook_time: 0,
  servings: 0,
  featured_image: '',
  ingredients: [],
  instructions: [],
  authors: []
} : recipe!.data;

const pageTitle = isGhost ? 'New Recipe' : data.title;
const pageDesc = isGhost ? 'Pending deploy' : data.description;
---

<style>
  @keyframes page-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .recipe-page {
    animation: page-fade-in 0.25s ease-out;
  }
</style>

<Layout title={pageTitle} description={pageDesc} resolveAuth={false}>
  <div class="recipe-page" data-is-ghost={isGhost ? "true" : "false"}>
    <div class="recipe-shell">
      <section class="recipe-hero rise">
        <div class="hero-content">
          <div class="flex items-center gap-4">
            <a
              href="/recipes"
              class="inline-flex items-center justify-center w-12 h-12 rounded-full border border-gray-200 bg-white text-gray-700 hover:border-gray-900 transition-colors shrink-0 mt-1"
              aria-label="Back to recipes"
              data-back
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7" />
              </svg>
            </a>
            <h1 class="hero-title hydrate-title">{data.title}</h1>
            {!isGhost && (
              <button
                type="button"
                id="share-recipe-btn"
                class="ml-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-gray-200 bg-white text-[10px] font-bold uppercase tracking-widest text-gray-700 hover:border-gray-900 transition-colors shrink-0"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M13.1202 17.0228L8.92129 14.7324C8.19135 15.5125 7.15261 16 6 16C3.79086 16 2 14.2091 2 12C2 9.79086 3.79086 8 6 8C7.15255 8 8.19125 8.48746 8.92118 9.26746L13.1202 6.97713C13.0417 6.66441 13 6.33707 13 6C13 3.79086 14.7909 2 17 2C19.2091 2 21 3.79086 21 6C21 8.20914 19.2091 10 17 10C15.8474 10 14.8087 9.51251 14.0787 8.73246L9.87977 11.0228C9.9583 11.3355 10 11.6629 10 12C10 12.3371 9.95831 12.6644 9.87981 12.9771L14.0788 15.2675C14.8087 14.4875 15.8474 14 17 14C19.2091 14 21 15.7909 21 18C21 20.2091 19.2091 22 17 22C14.7909 22 13 20.2091 13 18C13 17.6629 13.0417 17.3355 13.1202 17.0228ZM6 14C7.10457 14 8 13.1046 8 12C8 10.8954 7.10457 10 6 10C4.89543 10 4 10.8954 4 12C4 13.1046 4.89543 14 6 14ZM17 8C18.1046 8 19 7.10457 19 6C19 4.89543 18.1046 4 17 4C15.8954 4 15 4.89543 15 6C15 7.10457 15.8954 8 17 8ZM17 20C18.1046 20 19 19.1046 19 18C19 16.8954 18.1046 16 17 16C15.8954 16 15 16.8954 15 18C15 19.1046 15.8954 20 17 20Z" />
                </svg>
                <span class="hidden sm:inline">Share recipe</span>
              </button>
            )}
          </div>
          <div class="hero-rating">
            <svg class="hero-heart" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 20.364l-7.682-7.682a4.5 4.5 0 016.364-6.364L12 7.636l1.318-1.318a4.5 4.5 0 016.364 6.364L12 20.364z" />
            </svg>
            <span class="hero-rating-count">{heartCount}</span>
            <span class="hero-rating-label">hearts</span>
          </div>
          {data.authors && data.authors.length > 0 && (
            <div class="hero-authors">
              <span class="authors-label">By</span>
              <div class="authors-list">
                {data.authors.map((author: any, index: number) => (
                  <div class="author-item">
                    {author.image && (
                      <img 
                        src={author.image} 
                        alt={author.name}
                        class="author-image"
                        title={author.name}
                      />
                    )}
                    <span class="author-name">{author.name}</span>
                    {index < (data.authors?.length ?? 0) - 1 && (
                      <span class="author-separator">
                        {index === (data.authors?.length ?? 0) - 2 ? ' & ' : ', '}
                      </span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>

      <script is:inline define:vars={{ slug }}>
        // Pre-paint: the static build renders 0 hearts, so show the cached
        // count from the last page-data fetch before the hero ever paints.
        // The fresh fetch afterwards reconciles quietly
        try {
          const cachedLayout = JSON.parse(localStorage.getItem('recipes_layout_v2') || 'null');
          const countEl = document.querySelector('.hero-rating-count');
          if (countEl && cachedLayout && cachedLayout.hearts && cachedLayout.hearts[slug] != null) {
            countEl.textContent = String(cachedLayout.hearts[slug]);
          }
        } catch (e) {}
      </script>

      {!isGhost && (
        <div id="share-recipe-modal" class="hidden fixed inset-0 z-[120]" role="dialog" aria-modal="true" aria-labelledby="share-recipe-title">
          <div id="share-recipe-backdrop" class="absolute inset-0 bg-black/50 opacity-0 transition-opacity duration-200"></div>
          <div id="share-recipe-wrap" class="absolute inset-0 flex items-center justify-center p-4">
            <div id="share-recipe-panel" class="relative w-full max-w-md bg-white rounded-2xl shadow-2xl p-6 opacity-0 translate-y-2 transition-all duration-200">
              <button
                type="button"
                id="share-recipe-close"
                class="absolute top-4 right-4 inline-flex items-center justify-center w-8 h-8 rounded-full text-gray-400 hover:text-gray-900 hover:bg-gray-50 transition-colors"
                aria-label="Close"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
              <h2 id="share-recipe-title" class="font-serif text-xl text-gray-900 mb-1">Share recipe</h2>
              <p class="text-sm text-gray-500 mb-5">
                Anyone with this link can view this recipe.
              </p>
              <div class="flex items-center gap-2">
                <input
                  type="text"
                  id="share-recipe-link"
                  readonly
                  class="flex-1 min-w-0 px-3 py-2.5 text-xs bg-gray-50 border border-gray-200 rounded-lg text-gray-700 font-mono"
                />
                <button
                  type="button"
                  id="share-recipe-copy"
                  class="shrink-0 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-900 text-white hover:bg-gray-700 transition-colors"
                  aria-label="Copy link to clipboard"
                >
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-copy-icon>
                    <path d="M6.9998 6V3C6.9998 2.44772 7.44752 2 7.9998 2H19.9998C20.5521 2 20.9998 2.44772 20.9998 3V17C20.9998 17.5523 20.5521 18 19.9998 18H16.9998V20.9991C16.9998 21.5519 16.5499 22 15.993 22H4.00666C3.45059 22 3 21.5554 3 20.9991L3.0026 7.00087C3.0027 6.44811 3.45264 6 4.00942 6H6.9998ZM5.00242 8L5.00019 20H14.9998V8H5.00242ZM8.9998 6H16.9998V16H18.9998V4H8.9998V6Z" />
                  </svg>
                  <svg class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" data-copied-icon>
                    <path d="M10 15.172l9.192-9.193 1.415 1.414L10 18l-6.364-6.364 1.414-1.414L10 15.172z" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      )}

      {!isGhost && (
        <script is:inline>
          // Bound once via delegation: the client router swaps in fresh DOM
          // without re-running identical inline scripts, so element-bound
          // listeners would leave the button dead on revisited recipes
          (function () {
            if (window.__recipeShareBound) return;
            window.__recipeShareBound = true;

            let copiedTimer;

            const els = () => ({
              modal: document.getElementById('share-recipe-modal'),
              backdrop: document.getElementById('share-recipe-backdrop'),
              wrap: document.getElementById('share-recipe-wrap'),
              panel: document.getElementById('share-recipe-panel'),
              linkInput: document.getElementById('share-recipe-link'),
              copyBtn: document.getElementById('share-recipe-copy')
            });

            const snackbar = (message) => {
              const el = document.createElement('div');
              el.textContent = message;
              el.style.cssText =
                'position:fixed;left:50%;bottom:32px;transform:translateX(-50%) translateY(8px);' +
                'background:#111827;color:#fff;padding:10px 20px;border-radius:999px;' +
                'font-size:12px;font-weight:600;letter-spacing:0.05em;z-index:300;' +
                'opacity:0;transition:opacity 250ms ease, transform 250ms cubic-bezier(0.16,1,0.3,1);' +
                'box-shadow:0 10px 25px rgba(0,0,0,0.15);pointer-events:none;max-width:90vw;text-align:center';
              document.body.appendChild(el);
              requestAnimationFrame(() => {
                el.style.opacity = '1';
                el.style.transform = 'translateX(-50%) translateY(0)';
              });
              setTimeout(() => {
                el.style.opacity = '0';
                el.style.transform = 'translateX(-50%) translateY(8px)';
                setTimeout(() => el.remove(), 300);
              }, 2000);
            };

            const openModal = () => {
              const { modal, backdrop, panel, linkInput } = els();
              if (!modal || !panel || !linkInput) return;
              linkInput.value = window.location.origin + window.location.pathname;
              modal.classList.remove('hidden');
              document.body.style.overflow = 'hidden';
              requestAnimationFrame(() => {
                backdrop?.classList.remove('opacity-0');
                panel.classList.remove('opacity-0', 'translate-y-2');
              });
            };

            const closeModal = () => {
              const { modal, backdrop, panel } = els();
              if (!modal) return;
              backdrop?.classList.add('opacity-0');
              panel?.classList.add('opacity-0', 'translate-y-2');
              document.body.style.overflow = '';
              setTimeout(() => modal.classList.add('hidden'), 200);
            };

            const copyLink = async () => {
              const { linkInput, copyBtn } = els();
              if (!linkInput || !copyBtn) return;
              try {
                await navigator.clipboard.writeText(linkInput.value);
              } catch {
                linkInput.select();
                document.execCommand('copy');
              }
              const copyIcon = copyBtn.querySelector('[data-copy-icon]');
              const copiedIcon = copyBtn.querySelector('[data-copied-icon]');
              copyIcon?.classList.add('hidden');
              copiedIcon?.classList.remove('hidden');
              snackbar('Copied to clipboard!');
              clearTimeout(copiedTimer);
              copiedTimer = setTimeout(() => {
                copyIcon?.classList.remove('hidden');
                copiedIcon?.classList.add('hidden');
              }, 1500);
            };

            document.addEventListener('click', (event) => {
              const target = event.target;
              if (!(target instanceof Element)) return;
              if (target.closest('#share-recipe-btn')) return openModal();
              if (target.closest('#share-recipe-copy')) return void copyLink();
              if (target.closest('#share-recipe-close')) return closeModal();
              const { wrap, backdrop } = els();
              if (backdrop && target === backdrop) return closeModal();
              if (wrap && target === wrap) return closeModal();
            });

            document.addEventListener('keydown', (event) => {
              const { modal } = els();
              if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
                closeModal();
              }
            });
          })();
        </script>
      )}

      <section class="recipe-media rise" style="--rise-delay: 60ms;">
        <div class="hero-media">
          <img 
            src={data.featured_image || ''} 
            alt={data.title} 
            class={`hero-image hydrate-image ${!data.featured_image ? 'hidden' : ''}`} 
          />
          {!data.featured_image && (
            <div class="hero-fallback"></div>
          )}
        </div>
        <aside class="info-card">
          <h2 class="section-title">Details</h2>
          <div class="meta-card meta-card-category">
            <p class="meta-label">Category</p>
            <p class="meta-value hydrate-category">{data.category}</p>
          </div>
          <div class="hero-meta">
            <div class="meta-card">
              <p class="meta-label">Prep</p>
              <p class="meta-value hydrate-prep">{data.prep_time ? `${data.prep_time} min` : '-'}</p>
            </div>
            <div class="meta-card">
              <p class="meta-label">Cook</p>
              <p class="meta-value hydrate-cook">{data.cook_time ? `${data.cook_time} min` : '-'}</p>
            </div>
            <div class="meta-card">
              <p class="meta-label">Servings</p>
              <p class="meta-value hydrate-servings">{data.servings || '-'}</p>
            </div>
          </div>
        </aside>
      </section>

      <section class="recipe-description rise" style="--rise-delay: 120ms;">
        <p class="description-text hydrate-description">{data.description}</p>
      </section>

      <section class="recipe-body rise" style="--rise-delay: 180ms;">
        <aside class="ingredients-card">
          <h2 class="section-title">Ingredients</h2>
          <div class="ingredient-controls" data-base-servings={data.servings || ''}>
            <div class="control-group">
              <span class="control-label">Servings</span>
              <div class="stepper">
                <button type="button" class="stepper-btn" data-servings-decrement aria-label="Decrease servings">−</button>
                <span class="stepper-value" data-servings-value>{data.servings || 1}</span>
                <button type="button" class="stepper-btn" data-servings-increment aria-label="Increase servings">+</button>
              </div>
            </div>
          </div>
          <ul class="ingredients-list hydrate-ingredients">
            {(data.ingredients || []).map((ingredient) => (
              <li class="ingredient-row">
                <span class="ingredient-amount" data-original-amount={ingredient.amount}>{ingredient.amount}</span>
                <span class="ingredient-item">{ingredient.item}</span>
              </li>
            ))}
          </ul>
          <div style="margin-top: 1.5rem;">
            {!isGhost && <AddAllToShoppingListButton ingredients={data.ingredients} client:visible />}
          </div>
        </aside>

        <div class="method-card">
          <h2 class="section-title">Method</h2>
          <ol class="method-list hydrate-instructions">
            {(data.instructions || []).map((instruction, index) => (
              <li class="method-step">
                <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
                <p class="step-text">{instruction.step}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    </div>
  </div>

  {!isGhost && (
    <CommentSection
      client:visible
      recipeId={slug!}
    />
  )}

  <script>
    import { prefetch } from 'astro:prefetch';
    import { getPageData } from '../../lib/pageData';

    // Warm the listing HTML so pressing back never waits on the network.
    // No-op in dev; works on the production build
    function warmRecipesList() {
      if (window.location.pathname.startsWith('/recipes/')) {
        prefetch('/recipes');
      }
    }
    warmRecipesList();
    document.addEventListener('astro:page-load', warmRecipesList);

    // Client-side swaps replace the DOM with the static 0, and the inline
    // pre-paint script doesn't re-run then, so re-apply the cached count
    // before the swapped page paints
    function applyCachedHeroCount() {
      try {
        const countEl = document.querySelector('.hero-rating-count');
        const slug = window.location.pathname.split('/').filter(Boolean).pop();
        if (!countEl || !slug) return;
        const layout = JSON.parse(localStorage.getItem('recipes_layout_v2') || 'null');
        if (layout?.hearts && layout.hearts[slug] != null) {
          countEl.textContent = String(layout.hearts[slug]);
        }
      } catch {}
    }

    async function hydrateHearts() {
      const countEl = document.querySelector('.hero-rating-count');
      const page = document.querySelector('.recipe-page');
      if (!countEl || !page || page.getAttribute('data-is-ghost') === 'true') return;

      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (!slug) return;

      const data = await getPageData();
      if (!data) return;
      countEl.textContent = String(data.hearts[slug] || 0);
    }

    document.addEventListener('astro:after-swap', applyCachedHeroCount);
    hydrateHearts();
    document.addEventListener('astro:page-load', hydrateHearts);
  </script>

  <script is:inline define:vars={{ slug }}>
    // Hydrate from localStorage for optimistic updates
    document.addEventListener('astro:page-load', () => {
      const cacheKey = 'recipe_pending_v1_' + slug;
      const raw = localStorage.getItem(cacheKey);
      
      const ghostEl = document.querySelector('[data-is-ghost="true"]');

      if (!raw) {
        if (ghostEl) {
          // If it's a ghost page and no cache found, redirect to 404
          window.location.href = '/404';
        }
        return;
      }

      try {
        const { timestamp, data } = JSON.parse(raw);
        // If older than 10 minutes, ignore
        if (Date.now() - timestamp > 10 * 60 * 1000) {
          if (ghostEl) window.location.href = '/404';
          return;
        }

        // Compare title to see if the live page has caught up
        const serverTitle = document.querySelector('.hydrate-title')?.textContent;
        if (serverTitle === data.title) {
          // The live page is now up to date or matches the cache
          // Check other fields just to be sure
          const serverDesc = document.querySelector('.hydrate-description')?.textContent;
          if (serverDesc === data.description) {
            console.log('Live page matches cache. Clearing optimistic cache.');
            localStorage.removeItem(cacheKey);
            return;
          }
        }

        console.log('Optimistically hydrating recipe from cache:', slug);

        // Update basic text
        const titleEl = document.querySelector('.hydrate-title');
        if (titleEl) titleEl.textContent = data.title;
        
        const descEl = document.querySelector('.hydrate-description');
        if (descEl) descEl.textContent = data.description;
        
        const categoryEl = document.querySelector('.hydrate-category');
        if (categoryEl) categoryEl.textContent = data.category;
        
        const prepEl = document.querySelector('.hydrate-prep');
        if (prepEl) prepEl.textContent = `${data.prep_time} min`;
        
        const cookEl = document.querySelector('.hydrate-cook');
        if (cookEl) cookEl.textContent = `${data.cook_time} min`;
        
        const servingsEl = document.querySelector('.hydrate-servings');
        if (servingsEl) servingsEl.textContent = data.servings;

        // Update image
        const imgEl = document.querySelector('.hydrate-image');
        const fallbackEl = document.querySelector('.hero-fallback');
        if (imgEl && data.featured_image) {
          imgEl.src = data.featured_image;
          imgEl.alt = data.title;
          
          if ( window.recipeImageCache ) {
            window.recipeImageCache.get(data.featured_image).then((cachedUrl) => {
              if (imgEl && cachedUrl) imgEl.src = cachedUrl;
            });
          }

          imgEl.classList.remove('hidden');
          if (fallbackEl) fallbackEl.classList.add('hidden');
        }

        // Update ingredients
        const ingredientsList = document.querySelector('.hydrate-ingredients');
        if (ingredientsList && data.ingredients) {
          ingredientsList.innerHTML = data.ingredients.map(ing => `
            <li class="ingredient-row">
              <span class="ingredient-amount" data-original-amount="${(ing.amount || '').replace(/"/g, '&quot;')}">${ing.amount}</span>
              <span class="ingredient-item">${ing.item}</span>
            </li>
          `).join('');
          // Re-apply scaling after re-render
          window.dispatchEvent(new Event('recipe:ingredients-updated'));
        }

        // Update instructions
        const instructionsList = document.querySelector('.hydrate-instructions');
        if (instructionsList && data.instructions) {
          instructionsList.innerHTML = data.instructions.map((ins, i) => `
            <li class="method-step">
              <span class="step-number">${String(i + 1).padStart(2, '0')}</span>
              <p class="step-text">${ins.step}</p>
            </li>
          `).join('');
        }
      } catch (e) {
        console.warn('Failed to hydrate from cache:', e);
      }
    });
  </script>

  <script is:inline>
    // Ingredient scaler.
    // Parses amount strings like "250g", "1 1/2 cups", "200 ml", "2", "1-2 tbsp"
    // Scales by (current servings / base servings)
    (function () {
      // Match leading number — supports "1", "1.5", "1/2", "1 1/2", "1-2", "1 to 2"
      // group 1 = whole number, group 2 = fraction "a/b", group 3 = range upper
      const NUM_RE = /^\s*(\d+(?:\.\d+)?)?\s*(?:(\d+)\s*\/\s*(\d+))?\s*(?:[-–to]+\s*(\d+(?:\.\d+)?(?:\s+\d+\s*\/\s*\d+)?))?/i;

      function parseNumber(str) {
        if (!str) return null;
        const m = str.match(NUM_RE);
        if (!m || (!m[1] && !m[2])) return null;
        let value = 0;
        if (m[1]) value += parseFloat(m[1]);
        if (m[2] && m[3]) value += parseInt(m[2], 10) / parseInt(m[3], 10);
        const consumed = m[0];
        // Range upper bound (we'll scale both, recombine as "lo–hi")
        let upper = null;
        if (m[4]) {
          const inner = m[4].match(/^(\d+(?:\.\d+)?)?\s*(?:(\d+)\s*\/\s*(\d+))?/);
          if (inner) {
            upper = 0;
            if (inner[1]) upper += parseFloat(inner[1]);
            if (inner[2] && inner[3]) upper += parseInt(inner[2], 10) / parseInt(inner[3], 10);
          }
        }
        return { value, upper, consumed: consumed.length };
      }

      function extractUnit(rest) {
        // Try multi-word units first
        const lc = rest.toLowerCase().trimStart();
        const lead = rest.length - rest.trimStart().length;
        if (lc.startsWith('fl oz')) return { unit: 'fl oz', length: lead + 5 };
        // Match any word (letters only) at start
        const m = lc.match(/^([a-z]+)/);
        if (!m) return { unit: '', length: 0 };
        return { unit: m[1], length: lead + m[1].length };
      }

      function formatNumber(n) {
        if (!isFinite(n)) return '';
        if (n >= 100) return Math.round(n).toString();
        if (n >= 10)  return (Math.round(n * 10) / 10).toString();
        // try common fractions for small numbers
        const whole = Math.floor(n);
        const frac = n - whole;
        const fractions = [
          [1/8, '⅛'], [1/4, '¼'], [1/3, '⅓'], [3/8, '⅜'],
          [1/2, '½'], [5/8, '⅝'], [2/3, '⅔'], [3/4, '¾'], [7/8, '⅞'],
        ];
        let bestDiff = 0.04;
        let bestSym = null;
        for (const [v, sym] of fractions) {
          const d = Math.abs(frac - v);
          if (d < bestDiff) { bestDiff = d; bestSym = sym; }
        }
        if (bestSym) return whole > 0 ? whole + ' ' + bestSym : bestSym;
        if (frac < 0.04) return whole.toString();
        return (Math.round(n * 100) / 100).toString();
      }

      function rewriteAmount(original, scale) {
        if (!original) return '';
        const parsed = parseNumber(original);
        if (!parsed) return original; // no leading number — leave as-is (e.g. "to taste", "pinch")

        const rest = original.slice(parsed.consumed);
        const { unit, length: unitLen } = extractUnit(rest);
        const trailing = rest.slice(unitLen); // anything after the unit

        const lo = parsed.value * scale;
        const hi = parsed.upper != null ? parsed.upper * scale : null;

        const numStr = hi != null
          ? `${formatNumber(lo)}–${formatNumber(hi)}`
          : formatNumber(lo);
        return `${numStr}${unit ? (unit === 'fl oz' || unit.length <= 3 ? unit : ' ' + unit) : ''}${trailing}`.trim();
      }

      function applyAll() {
        const controls = document.querySelector('.ingredient-controls');
        if (!controls) return;
        const baseServings = parseInt(controls.getAttribute('data-base-servings') || '0', 10);
        const valueEl = controls.querySelector('[data-servings-value]');
        const current = parseInt((valueEl && valueEl.textContent) || '1', 10) || 1;
        const scale = baseServings > 0 ? current / baseServings : 1;

        document.querySelectorAll('.ingredient-amount').forEach((el) => {
          const original = el.getAttribute('data-original-amount') ?? el.textContent ?? '';
          if (!el.hasAttribute('data-original-amount')) el.setAttribute('data-original-amount', original);
          const next = rewriteAmount(original, scale);
          el.textContent = next;
          if (scale !== 1) el.classList.add('is-scaled');
          else el.classList.remove('is-scaled');
        });
      }

      function init() {
        const controls = document.querySelector('.ingredient-controls');
        if (!controls) return;
        if (controls.dataset.bound === '1') return;
        controls.dataset.bound = '1';

        const baseServings = parseInt(controls.getAttribute('data-base-servings') || '0', 10);
        const valueEl = controls.querySelector('[data-servings-value]');
        const dec = controls.querySelector('[data-servings-decrement]');
        const inc = controls.querySelector('[data-servings-increment]');

        // Hide servings stepper if recipe has no base servings
        if (!baseServings) {
          const group = dec?.closest('.control-group');
          if (group) group.style.display = 'none';
        }

        dec?.addEventListener('click', () => {
          const cur = parseInt(valueEl.textContent || '1', 10);
          if (cur > 1) { valueEl.textContent = String(cur - 1); applyAll(); }
        });
        inc?.addEventListener('click', () => {
          const cur = parseInt(valueEl.textContent || '1', 10);
          if (cur < 99) { valueEl.textContent = String(cur + 1); applyAll(); }
        });

        applyAll();
      }

      document.addEventListener('astro:page-load', init);
      window.addEventListener('recipe:ingredients-updated', () => {
        // After optimistic re-render, controls element is unchanged but rows are new —
        // just re-apply.
        applyAll();
      });
    })();
  </script>
</Layout>

