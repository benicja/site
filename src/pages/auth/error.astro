---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Sign-in problem" resolveAuth={false}>
  <div class="max-w-2xl mx-auto px-4 py-32 text-center">
    <p class="text-[11px] font-bold uppercase tracking-[0.3em] text-gray-400">Sign in</p>
    <h1 class="mt-4 text-3xl md:text-4xl font-serif font-medium text-gray-900">That didn't work</h1>
    <p class="mt-4 text-gray-500 font-light">
      Something interrupted the sign-in with Google. This can happen when cookies
      are blocked or the page sat open for a while. Trying again almost always fixes it.
    </p>
    <div class="mt-10 flex items-center justify-center gap-4">
      <a
        href="/auth/login"
        data-astro-prefetch="false"
        class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-gray-900 text-white text-xs font-bold uppercase tracking-[0.2em] hover:bg-gray-700 transition-colors"
      >
        Try again
      </a>
      <a
        href="/"
        class="inline-flex items-center justify-center px-6 py-3 rounded-full border border-gray-200 text-gray-900 text-xs font-bold uppercase tracking-[0.2em] hover:border-gray-900 transition-colors"
      >
        Home
      </a>
    </div>
  </div>
</Layout>
